{
  "name": "yogesh-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Professional UI/UX Designer Portfolio",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:analyze": "vite build --debug",
    "type-check": "tsc --noEmit || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run type-check && npm run test && npm run build"
  },
  "keywords": [
    "portfolio",
    "ui-designer",
    "ux-designer",
    "figma"
  ],
  "author": "Yogesh Waran",
  "devDependencies": {
    "sass": "^1.72.0",
    "terser": "^5.31.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@vitest/ui": "^4.1.6",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.6"
  }
}
